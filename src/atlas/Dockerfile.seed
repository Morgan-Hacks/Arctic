# Standalone manual seed job. Not included in API or migration images.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json ./
COPY src/atlas/Directory.Build.props src/atlas/
COPY libs/Directory.Build.props libs/
COPY libs/audit/ libs/audit/
COPY src/atlas/MorganHacks.Directory.Contracts/ src/atlas/MorganHacks.Directory.Contracts/
COPY src/atlas/MorganHacks.Directory/ src/atlas/MorganHacks.Directory/
COPY src/atlas/MorganHacks.Seed/ src/atlas/MorganHacks.Seed/
COPY src/atlas/MorganHacks.Applications/ src/atlas/MorganHacks.Applications/
RUN --mount=type=secret,id=sixlabors_license_key,env=SixLaborsLicenseKey dotnet publish src/atlas/MorganHacks.Seed/MorganHacks.Seed.csproj -c Release -o /app
FROM mcr.microsoft.com/dotnet/runtime:10.0
RUN apt-get update && apt-get install -y --no-install-recommends libgssapi-krb5-2 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
ENTRYPOINT ["dotnet", "MorganHacks.Seed.dll"]
