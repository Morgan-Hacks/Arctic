<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />

    <!-- Resumes. The only object store in the system, and it is reached with
         the managed identity this service already holds rather than with an
         account key somebody has to keep somewhere. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared directory choices and validation, with no service or store
         dependencies. External assistant reads still enter through ports. -->
    <ProjectReference Include="../../../libs/directory/MorganHacks.Directory.Contracts/MorganHacks.Directory.Contracts.csproj" />
  </ItemGroup>
</Project>
